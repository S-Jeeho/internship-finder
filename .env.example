# ── Companies House ──────────────────────────────────────────────────────────
# Free API key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
# (OAuth 2.0 Desktop App client — enable Gmail API first)
GMAIL_CREDENTIALS_PATH=credentials.json
# Where the OAuth token is persisted after first login
GMAIL_TOKEN_PATH=token.json
# Your Gmail address (used as the sender)
GMAIL_SENDER_ADDRESS=your.email@gmail.com

# ── Google Maps (optional — for distance filtering) ───────────────────────────
# Leave blank to skip distance filtering
GOOGLE_MAPS_API_KEY=

# ── Search Settings ───────────────────────────────────────────────────────────
# Maximum distance from Manchester city centre to include a company (km)
MAX_DISTANCE_KM=80
# Maximum number of companies to process per pipeline run (0 = no limit)
MAX_COMPANIES_PER_RUN=20

# ── File Paths ────────────────────────────────────────────────────────────────
# Plain-text / Markdown version of your base CV (for Claude to read)
BASE_CV_PATH=data/cv_base.md
# SQLite database file
DB_PATH=data/internship_tracker.db
